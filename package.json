{
  "name": "@macula-io/ts",
  "version": "0.21.0",
  "description": "TypeScript SDK for the Macula mesh, over macula-go's shared C ABI",
  "license": "Apache-2.0",
  "keywords": [
    "macula",
    "mesh",
    "quic",
    "rpc",
    "pubsub",
    "ffi",
    "wire-protocol",
    "typescript",
    "p2p"
  ],
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/macula-io/macula-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macula-io/macula-ts.git"
  },
  "bugs": {
    "url": "https://github.com/macula-io/macula-ts/issues"
  },
  "author": {
    "name": "Macula",
    "email": "raf.lefever@erlef.org"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prebuilds"
  ],
  "scripts": {
    "build:go": "bash scripts/build-native.sh",
    "build:addon:dev": "npm run build:go && node-gyp rebuild",
    "build:prebuilds": "npm run build:go && prebuildify --napi --strip && npm pkg delete scripts.install",
    "build:ts": "rm -rf dist && tsc",
    "build": "npm run build:addon:dev && npm run build:ts",
    "test": "npm run build:go && vitest run",
    "test:live": "MACULA_TS_LIVE=1 vitest run src/fleet.live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "node-gyp": "^13.0.2",
    "prebuildify": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
