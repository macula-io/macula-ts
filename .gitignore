# Node
node_modules/
*.tsbuildinfo

# Regenerable build scaffolding -- rebuild via `npm run build:go` /
# `npm run build:addon:dev`. NOT the same as prebuilds/, which IS
# committed on purpose: it's the whole point of the prebuildify +
# node-gyp-build packaging (see README.md's "Packaging" section) --
# a consumer's `npm install` needs zero compile step because the
# matching binary is already sitting in the package, not gitignored
# away and rebuilt some other way.
cabi/build/
/build/

# dist/ (compiled TS output) and prebuilds/ (compiled native addon)
# ARE committed, deliberately, until a real `npm publish` pipeline
# with a prepublishOnly build step exists -- see package.json.

# OS
.DS_Store
