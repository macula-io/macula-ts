# Node
node_modules/
*.tsbuildinfo

# Regenerable build output: native/build is macula-go's cabi built by
# scripts/build-native.sh, /build the local addon node-gyp builds from it.
native/build/
/build/

# prebuilds/ is built per platform, from source, by the release workflow
# (prebuild-matrix.yml) and packed into the npm package there; it is never
# committed (macula-ts#2). `npm run build:prebuilds` makes this platform's
# locally.
prebuilds/

# dist/ (compiled TS output) IS committed: CI checks it is a fresh build of
# src/.

# OS
.DS_Store
